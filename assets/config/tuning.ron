// HARROW tuning values.
//
// Edit while the game is running: changes apply as soon as you save.
// If the file has a mistake, the game logs an error and keeps the old values.
// Units: metres, seconds, degrees.
(
    look: (
        // Degrees of turn per mouse count. Lower = slower.
        sensitivity: 0.05,
        invert_y: false,
        // Vertical field of view, degrees.
        fov: 72.0,
    ),
    controls: (
        // Hold or Toggle for each.
        sprint: Hold,
        crouch: Toggle,
        lean: Toggle,
    ),
    movement: (
        walk_speed: 3.4,
        sprint_speed: 5.6,
        crouch_speed: 1.9,
        prone_speed: 0.8,
        // How quickly you reach target speed (m/s gained per second).
        acceleration: 30.0,
        // How quickly you stop when you let go of the keys.
        deceleration: 40.0,
        gravity: 20.0,
        // Steepest walkable slope or stair ramp, degrees.
        max_slope: 45.0,
        // Keeps you glued to ramps and stairs when walking down them.
        ground_snap: 0.3,
    ),
    body: (
        radius: 0.3,
        stand_height: 1.8,
        crouch_height: 1.2,
        prone_height: 0.6,
        // Eye position below the top of the body.
        eye_from_top: 0.18,
        // Seconds to go between stand and crouch.
        crouch_time: 0.25,
        // Seconds to go between stand and prone.
        prone_time: 0.9,
    ),
    lean: (
        // Camera tilt at full lean, degrees.
        angle: 14.0,
        // How far the head (and camera) moves sideways at full lean, metres.
        offset: 0.32,
        // Seconds from upright to full lean.
        time: 0.18,
    ),
    view: (
        // Head bob while moving at walk speed. Set all to 0.0 to disable.
        // Up/down, metres.
        bob_height: 0.025,
        // Side to side, metres.
        bob_side: 0.012,
        // Tilt, degrees.
        bob_roll: 0.35,
    ),
    lighting: (
        // Camera exposure (EV100). Lower = brighter image. 15 = bright sun.
        exposure: 15.0,
        // Direct sun, lux. Real desert sun is ~100000.
        sun: 100000.0,
        // Sky fill light in shade, cd/m2. Lower = deeper shadows.
        ambient: 3500.0,
        // Eye adaptation: how many stops brighter the view may get when you
        // look into dark interiors (0 = off). Outdoors is never changed.
        adaptation_max: 2.0,
        // Scene brightness (log2) below which adaptation starts. Raise it to
        // adapt sooner, lower it to keep interiors darker.
        adaptation_threshold: -3.0,
        // Interior lanterns: brightness (game units, not real lumens), colour
        // (warm), and how far the light reaches in metres.
        lamp_intensity: 400000.0,
        lamp_colour: (1.0, 0.78, 0.52),
        lamp_range: 9.0,
        // Lanterns that cast no shadows (small rooms; shadows cost a render
        // pass each) light through walls, so they are dimmer and reach less
        // far: intensity and range are multiplied by this.
        unshadowed_lamp_scale: 0.7,
        // Shadow-casting lanterns only cast shadows when the camera is within
        // this many metres (each shadow map costs a render pass).
        lamp_shadow_distance: 16.0,
    ),
    // Per-surface look. scale = metres one texture repeat covers.
    // tint multiplies the texture colour (1.0 = unchanged; above 1 brightens).
    surfaces: {
        "stone": (scale: 2.4, tint: (1.5, 1.4, 1.2)),
        "plaster": (scale: 2.0, tint: (1.1, 1.07, 1.0)),
        "flagstone": (scale: 1.8, tint: (1.35, 1.28, 1.12)),
        "sand": (scale: 15.0, tint: (1.4, 1.3, 1.1)),
        "wood": (scale: 1.57, tint: (1.0, 1.0, 1.0)),
        "metal": (scale: 1.0, tint: (1.0, 1.0, 1.0)),
        "burlap": (scale: 0.27, tint: (1.0, 1.0, 1.0)),
        "rock": (scale: 2.7, tint: (1.25, 1.12, 0.95)),
        "fabric": (scale: 0.6, tint: (1.0, 0.95, 0.95)),
        "gravel": (scale: 2.48, tint: (1.25, 1.15, 1.0)),
    },
    footsteps: (
        // Metres travelled per footstep.
        walk_stride: 0.75,
        sprint_stride: 1.05,
        crouch_stride: 0.55,
        prone_stride: 0.5,
        // How loud a step is to the game (0 = silent, 1 = sprint). Bots and
        // detection gadgets will use this.
        walk_loudness: 0.5,
        sprint_loudness: 1.0,
        crouch_loudness: 0.12,
        prone_loudness: 0.04,
        // Footstep volume; multiplies audio.footsteps.
        volume: 0.7,
    ),
    // ---- Audio ----
    // Recorded sounds from assets/audio (tools/audio/build_audio.py).
    // Volumes are linear (1.0 = as recorded, 0.5 = about -6 dB). Your own
    // sounds play straight to your ears; everyone else's (shots, steps,
    // reloads), bullet impacts, breaking and explosions come from where they
    // happen: panned left/right and quieter with distance.
    audio: (
        // Overall volume (the menu's master slider).
        master: 1.0,
        // Weapons, impacts, destruction and explosions (the effects slider).
        effects: 1.0,
        // Everyone's footsteps.
        footsteps: 1.0,
        // Fall-off beyond a sound's `near` distance: volume = (near / distance)
        // ^ rolloff. 1.0 is real-world (-6 dB per doubling), 0 = no fall-off.
        // Every sound also fades out completely as it nears its `far` distance.
        rolloff: 1.0,
        // Distance between the listener's ears, metres (stereo panning).
        ear_gap: 0.2,
        // Every play varies pitch by up to +-4% and volume by up to +-1.5 dB
        // so repeats don't sound mechanical.
        pitch_jitter: 0.04,
        volume_jitter_db: 1.5,
        // Most world sounds at once; extra footsteps/impacts are skipped.
        // Your own sounds and explosions always play.
        max_voices: 48,
        // Bullet impacts: at most this many sounds per second (full auto,
        // shotgun pellets), and impacts within (metres, seconds) of one that
        // is already playing are skipped.
        impacts_per_second: 24.0,
        impact_merge: (0.6, 0.08),
        // Other people's gunshots and explosions cross over from the close
        // recording to the distant one between these distances (metres).
        distant_blend: (15.0, 80.0),
        // Melee and other non-violent damage that knocks out at least this
        // many cells also plays a breaking sound.
        break_min_cells: 6,
        // Per kind of sound: volume, full volume up to `near` metres, silent
        // from `far` metres.
        categories: (
            shots: (volume: 1.0, near: 6.0, far: 400.0),
            shots_distant: (volume: 0.8, near: 30.0, far: 800.0),
            // Reloads, dry fire, weapon draw.
            foley: (volume: 0.7, near: 1.5, far: 25.0),
            footsteps: (volume: 0.5, near: 3.0, far: 40.0),
            impacts: (volume: 0.6, near: 2.0, far: 70.0),
            destruction: (volume: 0.8, near: 4.0, far: 120.0),
            explosions: (volume: 0.85, near: 10.0, far: 600.0),
            explosions_distant: (volume: 0.8, near: 40.0, far: 1500.0),
        ),
        // What surfaces sound like (footsteps and bullet impacts), from the
        // name of the piece or collider: the first pattern found in the name
        // (case ignored) wins. Materials: Stone, Plaster, Wood, Metal, Sand.
        // Destructible walls/floors use their own material instead (plaster
        // or wood; Metal on a hatch frame or where a reinforcement plate
        // faces you).
        surfaces: [
            ("hatch", Wood),
            ("floor_wood", Wood),
            ("crate", Wood),
            ("barricade", Wood),
            ("plank", Wood),
            ("railing", Wood),
            ("wood", Wood),
            ("plate", Metal),
            ("metal", Metal),
            ("grate", Metal),
            ("sandbag", Sand),
            ("sand", Sand),
            ("desert", Sand),
            ("dune", Sand),
            ("ground", Sand),
            ("soft_wall", Plaster),
            ("plaster", Plaster),
            ("stairs", Stone),
            ("stone", Stone),
        ],
        // Anything else (flagstones, battlements, grey-box blocks).
        default_surface: Stone,
    ),
    // ---- Weapons (M3) ----
    // Angles are degrees, times seconds, distances metres.
    weapons: (
        // Aim down sights with the right mouse button: Hold or Toggle.
        ads_mode: Hold,
        // After a sprint you can't fire or aim for this long.
        sprint_recovery: 0.25,
        // Time to lower the weapon in your hands when switching (then the
        // new weapon's draw_time).
        holster_time: 0.2,
        // Pulling the trigger on an empty magazine starts a reload.
        auto_reload: true,
        // How loud weapons are to gameplay (detection gadgets, later bots),
        // on the footstep scale (1.0 = a sprinting footstep).
        noise: (
            gunshot: 3.0,
            reload: 0.6,
        ),
        // Damage multiplier by body region. With headshot_kills, any bullet
        // to the head is lethal (like the feel target); otherwise `head`
        // applies.
        damage: (
            headshot_kills: true,
            head: 2.5,
            torso: 1.0,
            legs: 0.75,
        ),
        // Bullets pass through soft surfaces (plaster, wood) and stop at
        // hard ones (stone).
        penetration: (
            // Share of damage kept after each soft surface (0.6 = 60%).
            soft_damage_kept: 0.6,
            // How many soft surfaces one bullet can pass through.
            max_soft_layers: 2,
            // Furthest a bullet travels, metres.
            range: 300.0,
        ),
        // Primary: TAMARISK assault rifle.
        primary: (
            name: "TAMARISK",
            // The 3D model in your hands. To use a different model, change
            // these (no code needed); `pose` below places it on screen.
            model: (
                // glTF file under assets/. Path changes need a restart;
                // the rest applies on save. tamarisk.glb is the realistic
                // model (built by tools/scripts/import_weapons.sh from a
                // CC0 source); tamarisk_blockout.glb is the scripted
                // blockout, kept as a fallback.
                path: "models/weapons/tamarisk.glb",
                // Uniform scale (0.01 for a model made in centimetres).
                scale: 1.0,
                // Turns the model so the barrel points away from you and the
                // top is up: (yaw, pitch, roll), degrees.
                rotation: (0.0, 0.0, 0.0),
                // Point on the sight line (lined up with your eye when aiming)
                // and the barrel tip, in the model's own units, e.g.
                // Some((0.0, 0.12, 0.0)). None = take them from the nodes
                // named sight_node / muzzle_node in the model.
                sight: None,
                muzzle: None,
                sight_node: "SIGHT",
                muzzle_node: "MUZZLE",
                // Parts animated by reloads / shots: Some("node name") or None.
                magazine_node: Some("MAGAZINE"),
                slide_node: None,
                // Third person: the model's place on a character's weapon_r
                // bone (origin where the web of the right hand grips, +Y
                // along the barrel, +Z up). offset in metres (right,
                // forward, up); rotation (yaw, pitch, roll) turns the model
                // (barrel -Z, +Y up) into the bone's axes.
                third_person: (offset: (0.0, 0.0, 0.0), rotation: (0.0, 90.0, 0.0)),
                // First-person arms posed on this model (clip prefix in
                // models/characters/arms_*.glb, built by build_arms.sh), or
                // None. The blockouts have no arms.
                arms: Some("tamarisk"),
            ),
            // Damage per bullet before the body-region multiplier.
            damage: 42.0,
            // Damage drops linearly from full at falloff_start metres to
            // falloff_min (share of full) at falloff_end metres.
            falloff_start: 25.0,
            falloff_end: 40.0,
            falloff_min: 0.65,
            // Rounds per minute.
            rpm: 750.0,
            // true: fires while the trigger is held. false: one shot per click.
            full_auto: true,
            magazine: 30,
            // Reloading with rounds left keeps one in the chamber (30 + 1).
            chamber: true,
            // Spare rounds carried at spawn.
            reserve: 150,
            // Reload time with rounds left / from empty (includes chambering).
            reload_tactical: 2.4,
            reload_empty: 3.0,
            // Time to raise this weapon after switching to it.
            draw_time: 0.55,
            // Time to go from hip to fully aimed.
            ads_time: 0.32,
            // Aiming zooms the view by this much (1.0 = no zoom).
            ads_zoom: 1.25,
            // Move speed while fully aimed (1.0 = normal).
            ads_move_speed: 0.75,
            recoil: (
                // View kick per shot in degrees: (right, up). Shot 1 uses the
                // first pair, shot 2 the second... After the end of the list
                // the last `repeat_last` pairs repeat. Same every time, so it
                // can be learned.
                pattern: [
                    (0.0, 0.30), (0.03, 0.42), (-0.04, 0.46), (0.08, 0.48),
                    (0.12, 0.50), (0.10, 0.50), (-0.06, 0.48), (-0.14, 0.45),
                    (-0.18, 0.42), (-0.08, 0.40), (0.10, 0.40), (0.18, 0.38),
                    (0.14, 0.36), (-0.02, 0.36), (-0.16, 0.36), (-0.20, 0.34),
                    (-0.06, 0.34), (0.12, 0.34),
                ],
                repeat_last: 6,
                // Kick multiplier while fully aimed.
                ads_scale: 0.85,
                // After this long without firing, the view drifts back...
                recovery_delay: 0.15,
                // ...at this many degrees per second (0 = never returns).
                recovery_speed: 9.0,
            ),
            spread: (
                // Random bullet spread, degrees (radius of the cone).
                // Standing still, from the hip / fully aimed:
                hip: 1.8,
                ads: 0.12,
                // Added when moving at walking speed (hip / aimed):
                moving_hip: 1.0,
                moving_ads: 0.35,
                // Multipliers when crouched / prone.
                crouch_scale: 0.85,
                prone_scale: 0.7,
                // Added per shot during a burst, up to max_bloom; once you
                // stop firing it shrinks at bloom_recovery degrees per second.
                per_shot: 0.08,
                max_bloom: 1.2,
                // Share of that bloom that applies while fully aimed.
                ads_bloom_scale: 0.3,
                bloom_recovery: 4.0,
                // The first shot after a pause of first_shot_reset seconds
                // gets this share of the spread (0 = perfectly accurate).
                first_shot_scale: 0.25,
                first_shot_reset: 0.25,
            ),
            // Where the weapon sits on screen, metres from the eye.
            pose: (
                // Where the model origin (the grip, on our models) sits at the
                // hip: (right, up, forward). Aiming lines the sight point up
                // with the eye instead.
                hip: (0.15, -0.2, 0.42),
                // Eye to the sight point (the front sight) when aiming. The
                // rear sight is 0.38 m behind it on the real rifle.
                ads_distance: 0.72,
                // Visual kick per shot: backwards (metres) and upwards (degrees).
                kick_back: 0.025,
                kick_up: 2.5,
            ),
        ),
        // Sidearm: ACACIA pistol.
        sidearm: (
            name: "ACACIA",
            model: (
                // Realistic model; acacia_blockout.glb is the fallback.
                path: "models/weapons/acacia.glb",
                scale: 1.0,
                rotation: (0.0, 0.0, 0.0),
                sight: None,
                muzzle: None,
                sight_node: "SIGHT",
                muzzle_node: "MUZZLE",
                magazine_node: Some("MAGAZINE"),
                slide_node: Some("SLIDE"),
                third_person: (offset: (0.0, 0.0, 0.0), rotation: (0.0, 90.0, 0.0)),
                arms: Some("acacia"),
            ),
            damage: 48.0,
            falloff_start: 12.0,
            falloff_end: 25.0,
            falloff_min: 0.6,
            // Fastest you can click.
            rpm: 450.0,
            full_auto: false,
            magazine: 15,
            chamber: true,
            reserve: 60,
            reload_tactical: 2.0,
            reload_empty: 2.4,
            draw_time: 0.4,
            ads_time: 0.22,
            ads_zoom: 1.1,
            ads_move_speed: 0.85,
            recoil: (
                pattern: [(0.0, 1.1), (0.15, 1.2), (-0.2, 1.2), (0.1, 1.25)],
                repeat_last: 4,
                ads_scale: 0.85,
                recovery_delay: 0.08,
                recovery_speed: 16.0,
            ),
            spread: (
                hip: 1.4,
                ads: 0.2,
                moving_hip: 0.8,
                moving_ads: 0.3,
                crouch_scale: 0.85,
                prone_scale: 0.7,
                per_shot: 0.25,
                max_bloom: 1.0,
                ads_bloom_scale: 0.3,
                bloom_recovery: 5.0,
                first_shot_scale: 0.3,
                first_shot_reset: 0.3,
            ),
            pose: (
                hip: (0.1, -0.16, 0.5),
                ads_distance: 0.72,
                kick_back: 0.03,
                kick_up: 6.0,
            ),
        ),
        // The weapon in your hands (looks only).
        view: (
            // Field of view of the weapon camera, degrees. Lower = bigger weapon.
            fov: 60.0,
            // How far the weapon lags behind mouse look, and the most it can.
            sway: 0.02,
            sway_max: 4.0,
            // Weapon bob while walking (follows the footsteps), metres.
            bob_height: 0.012,
            bob_side: 0.01,
            // Sway and bob multiplier while fully aimed (0 = rock steady).
            ads_steadiness: 0.15,
        ),
        effects: (
            // How long the muzzle flash shows, seconds.
            muzzle_flash_time: 0.05,
            // Brightness of the light the flash casts on nearby walls, lumens.
            muzzle_light: 600000.0,
            // How long a bullet impact puff lasts, and the most at once.
            impact_time: 0.35,
            max_impacts: 64,
            // How long the hit marker shows.
            hit_marker_time: 0.25,
            // Weapon sound volume (shots, reloads); multiplies audio.effects.
            volume: 0.6,
        ),
        // Training dummies (`--dummies`).
        dummies: (
            health: 100.0,
            // Seconds a dummy stays down before standing back up.
            respawn_time: 3.0,
        ),
    ),
    // ---- Destruction (M4) ----
    // Plaster walls, wooden floors, hatches and barricades are split into
    // small cells that bullets, melee and explosives knock out.
    // Grid and layout values only affect walls/floors built after the change
    // (restart to apply them to the map); everything else applies at once.
    destruction: (
        // Size of one wall/floor cell, metres. Smaller = finer holes, but
        // more work per hole (0.1 = ~450 cells for a 2 m wall).
        cell_size: 0.1,
        walls: (
            // Strip down each side of a plaster wall that never breaks, metres.
            frame: 0.05,
            // Bottom lip left after any breach. Low enough to walk over
            // (above ~0.08 m it starts to block you).
            lip: 0.06,
            // Strip along the top that never breaks, metres.
            top_plate: 0.06,
            // Timber studs inside the wall: width, metres. Bullets and melee
            // leave them standing; only explosives break them.
            stud_width: 0.06,
            // Widest gap allowed between studs, metres. A person needs about
            // 0.6 m to squeeze through, so below that melee holes can't be
            // crawled through.
            stud_max_bay: 0.7,
        ),
        floors: (
            // Joists under wooden floors (and battens under hatch covers):
            // width, metres. Explosives only.
            joist_width: 0.04,
            // Widest gap between joists, metres. Under 0.6 m means you can
            // shoot holes in a floor but not drop through without explosives.
            joist_max_bay: 0.5,
        ),
        // A bullet knocks out the cell it hits; each neighbouring cell also
        // goes with this chance (0..1), so holes look ragged.
        bullet_extra_chance: 0.25,
        // Hole radius per shotgun pellet, metres (pellets overlap into one
        // big hole).
        pellet_radius: 0.07,
        // How ragged hole edges are, metres (+/- on every hole radius).
        hole_jitter: 0.03,
        melee: (
            // Reach from the eyes, metres (enough to hit a hatch at your feet).
            range: 1.7,
            // Thickness of the swing (a sphere this radius), metres.
            sweep_radius: 0.12,
            // Swinging through an existing hole still catches its edges
            // within this radius, so the hole keeps growing.
            edge_radius: 0.3,
            // Seconds between swings.
            cooldown: 0.8,
            // Damage to a person.
            damage: 35.0,
            // Hole radius after the 1st, 2nd, 3rd, 4th... hit on the same
            // spot, metres (the last value repeats).
            hole_radii: [0.14, 0.2, 0.26, 0.32],
            // Hits within this distance of an earlier one grow that hole.
            merge_distance: 0.5,
            // From this many hits on one spot, the hole also opens down to
            // the bottom lip: a crouch-through hole (studs still in the way).
            crouch_hole_hits: 3,
            // Width and height of that crouch-through hole, metres.
            crouch_hole_width: 0.75,
            crouch_hole_height: 1.3,
        ),
        explosion: (
            // If a blast's hole on a wall reaches within this distance of the
            // bottom lip, the wall below it is blown out down to the lip
            // (a walk-through opening), metres.
            blowout_reach: 0.5,
            // Width of that blown-out part, as a fraction of the blast hole.
            blowout_width: 0.9,
            // Inside this fraction of the damage radius people take full
            // damage; further out it drops off steeply (squared) to zero at
            // the edge.
            full_damage_fraction: 0.25,
            // Damage multiplier for each soft wall/floor between the blast and
            // a person. Stone and reinforced walls block it completely.
            soft_cover_factor: 0.5,
        ),
        // Melee hits from above that break a hatch cover open.
        hatch_melee_hits: 3,
        barricade: (
            // Planks break in pieces this long, metres.
            segment: 0.3,
            // Melee hits that clear a barricade completely.
            melee_hits: 2,
            // The first melee hit knocks out planks within this radius, metres.
            melee_radius: 0.5,
            // When less than this fraction of the planks is left, the rest
            // falls down (0..1).
            clear_below: 0.3,
            // Seconds a defender holds F to put up a barricade.
            build_time: 2.0,
            // How close to the doorway/window you must be, metres.
            reach: 2.0,
        ),
        reinforce: (
            // Seconds a defender holds F to reinforce a wall or hatch. Moving
            // or looking away cancels it.
            time: 5.0,
            // How close (from the eyes) you must be, metres.
            reach: 1.6,
            // Reinforcements each defender carries per round.
            per_defender: 2,
            // Metal plate and brace thickness, metres (looks only).
            plate_thickness: 0.02,
            brace_thickness: 0.03,
        ),
        breach_charge: (
            // Charges each attacker with this gadget carries.
            count: 3,
            // Seconds to hold 4 to stick one on.
            place_time: 1.0,
            // How close (from the eyes) you must be, metres. Your eyes are
            // 1.6 m above the floor, so floors need more than that.
            reach: 2.0,
            // On walls the charge sits at this height above the floor, so the
            // blast always opens a walk-through hole (top = height + radius;
            // a standing person needs about 1.9 m).
            wall_height: 1.15,
            // Radius of the hole it blows in a soft wall or floor, metres.
            breach_radius: 0.9,
            // People within this distance get hurt, metres (about half damage
            // at 1.5 m, a scratch at 2.5 m).
            damage_radius: 3.0,
            // Damage at point blank (100 = a full-health person).
            max_damage: 120.0,
        ),
        debris: (
            // Most chunks and dust puffs on screen at once (oldest go first).
            max_chunks: 250,
            max_dust: 60,
            // Most chunks one impact throws.
            chunks_per_impact: 14,
            // Seconds a chunk lies on the floor before fading out.
            lifetime: 5.0,
        ),
        // How loud destruction is to gameplay (detection gadgets, bots).
        // Same scale as footsteps: 1.0 = a sprinting footstep.
        noise: (
            // Any explosion (breach charges, grenades).
            explosion: 6.0,
            // A hatch breaking open or a barricade coming down.
            breaking: 1.5,
            // A melee swing that hits something.
            melee: 1.0,
            // Finishing a reinforcement (metal clanging into place).
            reinforce: 0.8,
        ),
    ),
    // ---- Round loop, operators and gadgets (M6) ----
    round: (
        // Seconds for each part of a round.
        timers: (
            // Choosing an operator before each round (press 1 or 2).
            select: 15.0,
            // Defenders set up; attackers wait at their spawn.
            prep: 45.0,
            // Attackers push. Time running out without a plant = defenders win.
            action: 180.0,
            // Hold F this long inside a site to plant the defuser.
            plant: 7.0,
            // A planted defuser runs this long, then the attackers win.
            defuser: 45.0,
            // Hold F this long next to a planted defuser to disable it.
            disable: 7.0,
            // The result banner shows this long before the next round.
            round_end: 5.0,
            // The match result shows this long, then a new match starts.
            match_end: 10.0,
        ),
        // Short timers used with --round-test (automated checks).
        test_timers: (
            select: 1.0,
            prep: 2.0,
            action: 8.0,
            plant: 2.0,
            defuser: 3.0,
            disable: 2.0,
            round_end: 1.5,
            match_end: 2.0,
        ),
        // Rounds a team needs to win the match.
        rounds_to_win: 4,
        // Same, with --round-test.
        test_rounds_to_win: 3,
        // Teams swap attack and defence after this many rounds (1 = every round).
        swap_sides_every: 1,
        // true = attackers can't leave their spawn during prep (they scout
        // with recon drones, key G).
        attackers_hold_in_prep: true,
        // How close (metres) a defender must be to a planted defuser to disable it.
        disable_reach: 1.5,
        // How close (metres) an attacker must walk to a dropped defuser to pick it up.
        pickup_reach: 1.2,
        // Damage taken for each armour rating (1.0 = full damage, 0.8 = 20% less).
        armour_damage: (rating_1: 1.0, rating_2: 0.9, rating_3: 0.8),
        // Movement speed for each speed rating (1.0 = normal speed).
        speed_multiplier: (rating_1: 0.9, rating_2: 1.0, rating_3: 1.1),
        // Operators: armour and speed ratings (1 to 3) and how many of their
        // unique gadget they carry.
        operators: (
            auger: (armour: 2, speed: 2, gadgets: 2),   // ring cutters
            lark: (armour: 1, speed: 3, gadgets: 4),    // sensor darts
            mortise: (armour: 3, speed: 1, gadgets: 3), // backplate charges
            fathom: (armour: 1, speed: 3, gadgets: 3),  // seismic stakes
        ),
        // Lark's sensor darts.
        darts: (
            // Launch speed, metres per second.
            speed: 40.0,
            // How fast a dart's flight curves down (metres per second, per second).
            drop: 4.0,
            // A dart that hits nothing within this many seconds is lost.
            max_flight: 1.5,
            // Seconds a stuck dart listens for.
            listen_time: 8.0,
            // Defender sounds within this many metres show to attackers.
            radius: 6.0,
            // Quietest sound a dart picks up. Footsteps: sprint 1.0, walk 0.5,
            // crouch-walk 0.12, prone 0.04, so crouch-walking is not heard.
            min_loudness: 0.2,
            // Damage a dart takes before it breaks.
            health: 10.0,
            // Defenders within this many metres hear a hiss when a dart lands.
            hiss_radius: 10.0,
        ),
        // Fathom's seismic stakes.
        stakes: (
            // How far in front of you (metres) a stake is hammered into the floor.
            place_distance: 0.9,
            // Attacker footsteps within this many metres (sideways) are pinged.
            radius: 6.0,
            // ...and within this many metres above or below (one floor is 3.2).
            vertical_reach: 4.0,
            // Quietest footstep a stake feels (walk 0.5, crouch-walk 0.12).
            min_loudness: 0.2,
            // Seconds between pings for the same attacker and stake.
            ping_interval: 0.5,
            // A sound at least this loud (gunshot 3, ring cutter 5, explosion 6)...
            saturate_loudness: 4.0,
            // ...within this many metres...
            saturate_radius: 8.0,
            // ...blinds the stake for this many seconds.
            saturate_time: 10.0,
            // Damage a stake takes before it breaks.
            health: 20.0,
        ),
        // How long revealed positions stay on screen, seconds.
        intel: (
            // Ripple markers from Lark's darts.
            ripple_time: 1.5,
            // Pings from Fathom's stakes.
            ping_time: 2.0,
        ),
        // Volume of round and gadget sounds (beeps, hiss, ticks).
        volume: 0.6,
        // ---- Gadgets (M6 part two) ----
        gadgets: (
            // A press of 3, 4 or G shorter than this (seconds) is a tap:
            // start a cutter, fire a backplate, connect to a drone/camera.
            // Holding longer places things (and throws a new drone with G).
            tap_time: 0.25,
            // Auger's ring cutter.
            ring_cutter: (
                // How close (from the eyes) the wall or hatch must be, metres.
                reach: 1.8,
                // Seconds holding 3 to clamp one on.
                clamp_time: 1.5,
                // Seconds of cutting to finish the plug.
                cut_time: 10.0,
                // Radius of the plug, metres (1.0 = a walk-through opening).
                cut_radius: 1.0,
                // Height of the plug's centre above the bottom of a wall, metres.
                cut_height: 1.0,
                // Fraction of the cut at which the blade breaks through to the
                // far side, where it can be shot to jam the cutter.
                expose_at: 0.5,
                // Seconds Auger holds 3 at a jammed cutter to re-seat it.
                reseat_time: 4.0,
                // How loud it is while cutting (footstep scale; explosion 6), and
                // how often that noise repeats (seconds). 4+ saturates stakes.
                noise: 5.0,
                noise_interval: 0.5,
                // Damage the cutter body takes before it breaks.
                health: 60.0,
                // Damage the exposed blade takes before the cutter jams (1 = any hit).
                blade_health: 1.0,
                // Passes the cutting head makes round the ring over a full cut.
                // Once through, the blade travels the far side this fast (3 =
                // about 2 m/s): slower is easier to shoot.
                revolutions: 3.0,
                // The falling plug knocks down (prone) and hurts anyone this
                // close behind it, metres (a hatch plug falls on whoever is below)...
                knockdown_depth: 1.5,
                // ...for this much damage.
                knockdown_damage: 25.0,
                // Your view shakes within this distance of a working cutter, metres.
                shake_radius: 4.0,
            ),
            // Mortise's backplate charges.
            backplate: (
                // How close (from the eyes) the reinforced plate must be, metres.
                reach: 1.6,
                // Seconds holding 3 to bolt one on.
                bolt_time: 1.5,
                // Attacker gadgets on the far side within this distance of the
                // charge are destroyed, metres.
                gadget_radius: 1.2,
                // Radius of the hole it punches in your own reinforcement, metres.
                hole_radius: 0.1,
                // People on the far side within this distance get hurt, metres...
                blast_radius: 1.2,
                // ...up to this much damage.
                blast_damage: 20.0,
                // Damage a placed charge takes before it breaks.
                health: 30.0,
            ),
            // How many of each shared secondary gadget a loadout carries (the
            // soft-breach charge count is destruction.breach_charge.count).
            counts: (
                frag: 2,
                flashbang: 3,
                smoke: 2,
                razor_wire: 2,
                ballistic_cover: 1,
                impact_charge: 2,
                proximity_alarm: 2,
            ),
            // Thrown grenades (frag, flashbang, smoke).
            throw: (
                // Throw speed, metres per second, plus this much upward lob.
                speed: 13.0,
                lift: 2.0,
                // Grenade size (radius), metres.
                radius: 0.045,
                // Bounciness (0..1) and grip on the floor.
                restitution: 0.35,
                friction: 0.6,
            ),
            frag: (
                // Seconds from pulling the pin (pressing 4) to the blast. Hold 4
                // to cook it; held too long, it goes off in your hand.
                fuse: 3.0,
                // Damage point blank (100 = a full-health person), and the
                // distance at which it falls to zero, metres.
                max_damage: 140.0,
                damage_radius: 4.5,
                // Radius of the hole it opens in soft walls and floors (never
                // reinforced ones), metres. Under 0.3 nobody drops through floors.
                breach_radius: 0.25,
            ),
            flashbang: (
                // Seconds from the throw to the bang.
                fuse: 1.6,
                // People with a clear line of sight within this distance are hit, metres.
                radius: 10.0,
                // Seconds of white-out looking straight at it, close up.
                blind_time: 5.0,
                // Seconds of muffled hearing (close up).
                deaf_time: 7.0,
                // Strength when looking directly away from it (0..1).
                look_away: 0.25,
                // How loud the bang is to gameplay (saturates stakes at 4+).
                loudness: 5.0,
            ),
            smoke: (
                // Seconds from the throw until it starts pouring smoke.
                fuse: 1.2,
                // Radius of the cloud, metres.
                radius: 3.5,
                // Seconds to reach full size, seconds at full density, seconds to fade.
                grow_time: 2.0,
                duration: 12.0,
                fade_time: 3.0,
                // Smoke puffs per cloud, and for all clouds together (cost cap).
                particles: 46,
                max_particles: 140,
            ),
            impact: (
                // Throw speed, metres per second.
                speed: 15.0,
                // Goes off on the first contact: hole radius in soft surfaces,
                // and a small blast for people, metres / damage.
                breach_radius: 0.75,
                damage_radius: 1.5,
                max_damage: 25.0,
                // Lost if it hits nothing within this many seconds.
                max_flight: 3.0,
            ),
            razor_wire: (
                // Seconds holding 4 to lay a roll, and how far ahead of you it goes, metres.
                place_time: 1.5,
                distance: 1.0,
                // Size of the roll: length across the doorway, depth, height, metres.
                length: 1.7,
                depth: 0.6,
                height: 0.55,
                // Movement speed inside it (1.0 = no effect).
                slow: 0.35,
                // How loud each footstep in it is (footstep scale; walk 0.5).
                noise: 1.2,
                // Damage it takes before it breaks (explosions, melee; bullets pass through).
                health: 80.0,
                // Damage of one melee swing on it.
                melee_damage: 45.0,
            ),
            cover: (
                // Seconds holding 4 to set it up, and how far ahead of you, metres.
                place_time: 1.5,
                distance: 0.9,
                // Size, metres (waist-high).
                width: 1.1,
                height: 1.0,
                // Blast damage it takes before it breaks (bullets don't hurt it).
                health: 150.0,
            ),
            alarm: (
                // Seconds holding 4 to stick one on, and reach, metres.
                place_time: 0.5,
                reach: 2.0,
                // Attackers within this distance (and this much above/below) set it off.
                radius: 3.0,
                vertical_reach: 2.0,
                // Seconds between beeps / reveals while someone is in range.
                ping_interval: 1.0,
                // Damage it takes before it breaks.
                health: 15.0,
            ),
            // Recon drones (attackers; G).
            drone: (
                // Drones each attacker carries.
                count: 2,
                // Throw speed, metres per second.
                throw_speed: 7.0,
                // Driving speed forward and backward (m/s), turn rate on A/D (deg/s).
                speed: 3.2,
                reverse_speed: 1.8,
                turn_rate: 150.0,
                // How quickly it reaches speed (m/s per second).
                acceleration: 14.0,
                gravity: 20.0,
                // Body radius, metres (fits through holes a little bigger than this).
                radius: 0.1,
                // Highest ledge it climbs, metres, and steepest ramp, degrees.
                step_height: 0.09,
                max_slope: 40.0,
                // Damage it takes before it breaks.
                health: 40.0,
                // Seconds of driving per battery.
                battery: 240.0,
                // Camera height above the floor, metres, and field of view, degrees.
                camera_height: 0.14,
                fov: 84.0,
                // Signal bars drop to zero at this distance from the operator, metres.
                signal_range: 45.0,
                // How loud its motor is to gameplay while moving (footstep scale).
                noise: 0.15,
            ),
            // Defender CCTV cameras (G).
            cctv: (
                // Damage a camera takes before it breaks.
                health: 10.0,
                // Field of view, degrees, and how far you can pan / tilt it, degrees.
                fov: 80.0,
                pan_limit: 55.0,
                tilt_limit: 30.0,
            ),
        ),
        // Harrow Keep has four bomb-site pairs (basement, ground, upper,
        // top) and four attacker spawns. Each round uses one pair, and one of
        // that pair's spawns for the attackers. Cycle = in order, one step
        // per round; Random; Fixed(n) = always the nth (from 1).
        site_pairs: Cycle,
        attacker_spawns: Cycle,
    ),
)
