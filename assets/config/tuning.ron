// HARROW tuning values.
//
// Edit while the game is running: changes apply as soon as you save.
// If the file has a mistake, the game logs an error and keeps the old values.
// Units: metres, seconds, degrees.
(
    look: (
        // Degrees of turn per mouse count. Lower = slower.
        sensitivity: 0.05,
        invert_y: false,
        // Vertical field of view, degrees.
        fov: 72.0,
    ),
    controls: (
        // Hold or Toggle for each.
        sprint: Hold,
        crouch: Toggle,
        lean: Toggle,
    ),
    movement: (
        walk_speed: 3.4,
        sprint_speed: 5.6,
        crouch_speed: 1.9,
        prone_speed: 0.8,
        // How quickly you reach target speed (m/s gained per second).
        acceleration: 30.0,
        // How quickly you stop when you let go of the keys.
        deceleration: 40.0,
        gravity: 20.0,
        // Steepest walkable slope or stair ramp, degrees.
        max_slope: 45.0,
        // Keeps you glued to ramps and stairs when walking down them.
        ground_snap: 0.3,
    ),
    body: (
        radius: 0.3,
        stand_height: 1.8,
        crouch_height: 1.2,
        prone_height: 0.6,
        // Eye position below the top of the body.
        eye_from_top: 0.18,
        // Seconds to go between stand and crouch.
        crouch_time: 0.25,
        // Seconds to go between stand and prone.
        prone_time: 0.9,
    ),
    lean: (
        // Camera tilt at full lean, degrees.
        angle: 14.0,
        // How far the head (and camera) moves sideways at full lean, metres.
        offset: 0.32,
        // Seconds from upright to full lean.
        time: 0.18,
    ),
    view: (
        // Head bob while moving at walk speed. Set all to 0.0 to disable.
        // Up/down, metres.
        bob_height: 0.025,
        // Side to side, metres.
        bob_side: 0.012,
        // Tilt, degrees.
        bob_roll: 0.35,
    ),
    lighting: (
        // Camera exposure (EV100). Lower = brighter image. 15 = bright sun.
        exposure: 15.0,
        // Direct sun, lux. Real desert sun is ~100000.
        sun: 100000.0,
        // Sky fill light in shade, cd/m2. Lower = deeper shadows.
        ambient: 3500.0,
        // Eye adaptation: how many stops brighter the view may get when you
        // look into dark interiors (0 = off). Outdoors is never changed.
        adaptation_max: 2.0,
        // Scene brightness (log2) below which adaptation starts. Raise it to
        // adapt sooner, lower it to keep interiors darker.
        adaptation_threshold: -3.0,
        // Interior lanterns: brightness (game units, not real lumens), colour
        // (warm), and how far the light reaches in metres.
        lamp_intensity: 400000.0,
        lamp_colour: (1.0, 0.78, 0.52),
        lamp_range: 9.0,
    ),
    // Per-surface look. scale = metres one texture repeat covers.
    // tint multiplies the texture colour (1.0 = unchanged; above 1 brightens).
    surfaces: {
        "stone": (scale: 2.4, tint: (1.5, 1.4, 1.2)),
        "plaster": (scale: 2.0, tint: (1.1, 1.07, 1.0)),
        "flagstone": (scale: 1.8, tint: (1.35, 1.28, 1.12)),
        "sand": (scale: 15.0, tint: (1.4, 1.3, 1.1)),
        "wood": (scale: 1.57, tint: (1.0, 1.0, 1.0)),
        "metal": (scale: 1.0, tint: (1.0, 1.0, 1.0)),
        "burlap": (scale: 0.27, tint: (1.0, 1.0, 1.0)),
    },
    footsteps: (
        // Metres travelled per footstep.
        walk_stride: 0.75,
        sprint_stride: 1.05,
        crouch_stride: 0.55,
        prone_stride: 0.5,
        // How loud a step is to the game (0 = silent, 1 = sprint). Bots and
        // detection gadgets will use this.
        walk_loudness: 0.5,
        sprint_loudness: 1.0,
        crouch_loudness: 0.12,
        prone_loudness: 0.04,
        // Volume of your own footsteps (placeholder sound).
        volume: 0.7,
    ),
    // ---- Weapons (M3) ----
    weapons: (),
    // ---- Destruction (M4) ----
    // Plaster walls, wooden floors, hatches and barricades are split into
    // small cells that bullets, melee and explosives knock out.
    // Grid and layout values only affect walls/floors built after the change
    // (restart to apply them to the map); everything else applies at once.
    destruction: (
        // Size of one wall/floor cell, metres. Smaller = finer holes, but
        // more work per hole (0.1 = ~450 cells for a 2 m wall).
        cell_size: 0.1,
        walls: (
            // Strip down each side of a plaster wall that never breaks, metres.
            frame: 0.05,
            // Bottom lip left after any breach. Low enough to walk over
            // (above ~0.08 m it starts to block you).
            lip: 0.06,
            // Strip along the top that never breaks, metres.
            top_plate: 0.06,
            // Timber studs inside the wall: width, metres. Bullets and melee
            // leave them standing; only explosives break them.
            stud_width: 0.06,
            // Widest gap allowed between studs, metres. A person needs about
            // 0.6 m to squeeze through, so below that melee holes can't be
            // crawled through.
            stud_max_bay: 0.7,
        ),
        floors: (
            // Joists under wooden floors (and battens under hatch covers):
            // width, metres. Explosives only.
            joist_width: 0.04,
            // Widest gap between joists, metres. Under 0.6 m means you can
            // shoot holes in a floor but not drop through without explosives.
            joist_max_bay: 0.5,
        ),
        // A bullet knocks out the cell it hits; each neighbouring cell also
        // goes with this chance (0..1), so holes look ragged.
        bullet_extra_chance: 0.25,
        // Hole radius per shotgun pellet, metres (pellets overlap into one
        // big hole).
        pellet_radius: 0.07,
        // How ragged hole edges are, metres (+/- on every hole radius).
        hole_jitter: 0.03,
        melee: (
            // Reach from the eyes, metres (enough to hit a hatch at your feet).
            range: 1.7,
            // Thickness of the swing (a sphere this radius), metres.
            sweep_radius: 0.12,
            // Swinging through an existing hole still catches its edges
            // within this radius, so the hole keeps growing.
            edge_radius: 0.3,
            // Seconds between swings.
            cooldown: 0.8,
            // Damage to a person.
            damage: 35.0,
            // Hole radius after the 1st, 2nd, 3rd, 4th... hit on the same
            // spot, metres (the last value repeats).
            hole_radii: [0.14, 0.2, 0.26, 0.32],
            // Hits within this distance of an earlier one grow that hole.
            merge_distance: 0.5,
            // From this many hits on one spot, the hole also opens down to
            // the bottom lip: a crouch-through hole (studs still in the way).
            crouch_hole_hits: 3,
            // Width and height of that crouch-through hole, metres.
            crouch_hole_width: 0.75,
            crouch_hole_height: 1.3,
        ),
        explosion: (
            // If a blast's hole on a wall reaches within this distance of the
            // bottom lip, the wall below it is blown out down to the lip
            // (a walk-through opening), metres.
            blowout_reach: 0.5,
            // Width of that blown-out part, as a fraction of the blast hole.
            blowout_width: 0.9,
            // Inside this fraction of the damage radius people take full
            // damage; further out it drops off steeply (squared) to zero at
            // the edge.
            full_damage_fraction: 0.25,
            // Damage multiplier for each soft wall/floor between the blast and
            // a person. Stone and reinforced walls block it completely.
            soft_cover_factor: 0.5,
        ),
        // Melee hits from above that break a hatch cover open.
        hatch_melee_hits: 3,
        barricade: (
            // Planks break in pieces this long, metres.
            segment: 0.3,
            // Melee hits that clear a barricade completely.
            melee_hits: 2,
            // The first melee hit knocks out planks within this radius, metres.
            melee_radius: 0.5,
            // When less than this fraction of the planks is left, the rest
            // falls down (0..1).
            clear_below: 0.3,
            // Seconds a defender holds F to put up a barricade.
            build_time: 2.0,
            // How close to the doorway/window you must be, metres.
            reach: 2.0,
        ),
        reinforce: (
            // Seconds a defender holds F to reinforce a wall or hatch. Moving
            // or looking away cancels it.
            time: 5.0,
            // How close (from the eyes) you must be, metres.
            reach: 1.6,
            // Reinforcements each defender carries per round.
            per_defender: 2,
            // Metal plate and brace thickness, metres (looks only).
            plate_thickness: 0.02,
            brace_thickness: 0.03,
        ),
        breach_charge: (
            // Charges each attacker with this gadget carries.
            count: 3,
            // Seconds to hold 4 to stick one on.
            place_time: 1.0,
            // How close (from the eyes) you must be, metres. Your eyes are
            // 1.6 m above the floor, so floors need more than that.
            reach: 2.0,
            // On walls the charge sits at this height above the floor, so the
            // blast always opens a walk-through hole (top = height + radius;
            // a standing person needs about 1.9 m).
            wall_height: 1.15,
            // Radius of the hole it blows in a soft wall or floor, metres.
            breach_radius: 0.9,
            // People within this distance get hurt, metres (about half damage
            // at 1.5 m, a scratch at 2.5 m).
            damage_radius: 3.0,
            // Damage at point blank (100 = a full-health person).
            max_damage: 120.0,
        ),
        debris: (
            // Most chunks and dust puffs on screen at once (oldest go first).
            max_chunks: 250,
            max_dust: 60,
            // Most chunks one impact throws.
            chunks_per_impact: 14,
            // Seconds a chunk lies on the floor before fading out.
            lifetime: 5.0,
        ),
    ),
    // ---- Round loop, operators and gadgets (M6) ----
    round: (
        // Seconds for each part of a round.
        timers: (
            // Choosing an operator before each round (press 1 or 2).
            select: 15.0,
            // Defenders set up; attackers wait at their spawn.
            prep: 45.0,
            // Attackers push. Time running out without a plant = defenders win.
            action: 180.0,
            // Hold F this long inside a site to plant the defuser.
            plant: 7.0,
            // A planted defuser runs this long, then the attackers win.
            defuser: 45.0,
            // Hold F this long next to a planted defuser to disable it.
            disable: 7.0,
            // The result banner shows this long before the next round.
            round_end: 5.0,
            // The match result shows this long, then a new match starts.
            match_end: 10.0,
        ),
        // Short timers used with --round-test (automated checks).
        test_timers: (
            select: 1.0,
            prep: 2.0,
            action: 8.0,
            plant: 2.0,
            defuser: 3.0,
            disable: 2.0,
            round_end: 1.5,
            match_end: 2.0,
        ),
        // Rounds a team needs to win the match.
        rounds_to_win: 4,
        // Same, with --round-test.
        test_rounds_to_win: 3,
        // Teams swap attack and defence after this many rounds (1 = every round).
        swap_sides_every: 1,
        // true = attackers can't leave their spawn during prep. (They would be
        // driving recon drones, which aren't built yet.)
        attackers_hold_in_prep: true,
        // How close (metres) a defender must be to a planted defuser to disable it.
        disable_reach: 1.5,
        // How close (metres) an attacker must walk to a dropped defuser to pick it up.
        pickup_reach: 1.2,
        // Damage taken for each armour rating (1.0 = full damage, 0.8 = 20% less).
        armour_damage: (rating_1: 1.0, rating_2: 0.9, rating_3: 0.8),
        // Movement speed for each speed rating (1.0 = normal speed).
        speed_multiplier: (rating_1: 0.9, rating_2: 1.0, rating_3: 1.1),
        // Operators: armour and speed ratings (1 to 3) and how many of their
        // unique gadget they carry.
        operators: (
            auger: (armour: 2, speed: 2, gadgets: 2),   // ring cutters
            lark: (armour: 1, speed: 3, gadgets: 4),    // sensor darts
            mortise: (armour: 3, speed: 1, gadgets: 3), // backplate charges
            fathom: (armour: 1, speed: 3, gadgets: 3),  // seismic stakes
        ),
        // Lark's sensor darts.
        darts: (
            // Launch speed, metres per second.
            speed: 40.0,
            // How fast a dart's flight curves down (metres per second, per second).
            drop: 4.0,
            // A dart that hits nothing within this many seconds is lost.
            max_flight: 1.5,
            // Seconds a stuck dart listens for.
            listen_time: 8.0,
            // Defender sounds within this many metres show to attackers.
            radius: 6.0,
            // Quietest sound a dart picks up. Footsteps: sprint 1.0, walk 0.5,
            // crouch-walk 0.12, prone 0.04, so crouch-walking is not heard.
            min_loudness: 0.2,
            // Damage a dart takes before it breaks.
            health: 10.0,
            // Defenders within this many metres hear a hiss when a dart lands.
            hiss_radius: 10.0,
        ),
        // Fathom's seismic stakes.
        stakes: (
            // How far in front of you (metres) a stake is hammered into the floor.
            place_distance: 0.9,
            // Attacker footsteps within this many metres (sideways) are pinged.
            radius: 6.0,
            // ...and within this many metres above or below (one floor is 3.2).
            vertical_reach: 4.0,
            // Quietest footstep a stake feels (walk 0.5, crouch-walk 0.12).
            min_loudness: 0.2,
            // Seconds between pings for the same attacker and stake.
            ping_interval: 0.5,
            // A sound at least this loud (gunshot 3, ring cutter 5, explosion 6)...
            saturate_loudness: 4.0,
            // ...within this many metres...
            saturate_radius: 8.0,
            // ...blinds the stake for this many seconds.
            saturate_time: 10.0,
            // Damage a stake takes before it breaks.
            health: 20.0,
        ),
        // How long revealed positions stay on screen, seconds.
        intel: (
            // Ripple markers from Lark's darts.
            ripple_time: 1.5,
            // Pings from Fathom's stakes.
            ping_time: 2.0,
        ),
        // Volume of round and gadget sounds (beeps, hiss, ticks).
        volume: 0.6,
    ),
)
